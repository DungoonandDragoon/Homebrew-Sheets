{
  "manifest_version": 3,
  "name": "Homebrew Sheet → Discord",
  "version": "2.0.0",
  "description": "Optional helper that posts rolls from the Homebrew Sheet to the Discord webhook set on each character.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://discord.com/*",
    "https://ptb.discord.com/*",
    "https://canary.discord.com/*",
    "https://discordapp.com/*",
    "https://dungoonanddragoon.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dungoonanddragoon.github.io/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Homebrew Sheet"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
